<mxfile host="app.diagrams.net">
  <diagram name="Architecture" id="momo-architecture">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="xml" value="Raw MoMo SMS XML&#10;data/raw/momo.xml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="etl_group" value="ETL Pipeline (etl/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontColor=#26215C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="160" width="600" height="290" as="geometry" />
        </mxCell>

        <mxCell id="parse" value="parse_xml.py&#10;Reads raw XML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="200" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="clean" value="clean_normalize.py&#10;Fixes dates, amounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="categorize" value="categorize.py&#10;Assigns category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="290" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="load" value="load_db.py (run.py orchestrates all steps)&#10;Creates tables, inserts records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="370" width="540" height="60" as="geometry" />
        </mxCell>

        <mxCell id="db" value="SQLite Database&#10;data/db.sqlite3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#1D9E75;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="490" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="api" value="API (optional)&#10;FastAPI /transactions /analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#D85A30;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="590" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dashboard" value="Web Dashboard&#10;index.html + chart_handler.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#378ADD;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="690" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="xml" target="etl_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="parse" target="clean">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="clean" target="categorize">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="categorize" target="load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="load" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="db" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="api" target="dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
